{
  "manifest_version": 3,
  "name": "Dial Browser Relay",
  "version": "1.0.0",
  "description": "Lets Dial drive the Chrome tabs you already have open, through a relay on this computer only.",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Dial browser relay",
    "default_popup": "popup.html"
  }
}
